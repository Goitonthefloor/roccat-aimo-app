pkgname=roccat-aimo-app
pkgver=0.2.0
pkgrel=1
pkgdesc='Userspace bridge and GTK4 controller for Roccat AIMO devices'
arch=('x86_64')
url='https://github.com/Goitonthefloor/roccat-aimo-app'
license=('MIT')
depends=('python' 'python-hidapi' 'python-gobject' 'gtk4' 'libadwaita')
makedepends=()
checkdepends=()
optdepends=()
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0033dcf52c09ea8cf6d9f5cf04456210d8bf4fcd651ad72fbdc26711ee895851')

prepare() {
  :
}

build() {
  :
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH="$srcdir/$pkgname-$pkgver/src" python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 src/roccat_aimo_bridge.py "$pkgdir/usr/bin/roccat-aimo-cli"
  install -Dm644 src/aimo_themes.py "$pkgdir/usr/bin/aimo_themes.py"
  install -Dm644 src/aimo_effects.py "$pkgdir/usr/bin/aimo_effects.py"
  install -Dm644 src/roccat_aimo_gui.py "$pkgdir/usr/lib/$pkgname/roccat_aimo_gui.py"
  install -Dm644 src/roccat_rgb.py "$pkgdir/usr/lib/$pkgname/roccat_rgb.py"
  install -Dm644 src/roccat-aimo-bridge.service \
    "$pkgdir/usr/lib/systemd/user/roccat-aimo-bridge.service"
  install -Dm644 src/roccat-aimo.desktop \
    "$pkgdir/usr/share/applications/roccat-aimo.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
